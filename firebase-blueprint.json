  "firestore": {
    "/settings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Configurações públicas e institucionais do site"
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Catálogo público de imóveis"
    },
    "/empreendimentos/{empreendimentoId}": {
      "schema": "Empreendimento",
      "description": "Catálogo de edifícios e condomínios"
    },
    "/landingPages/{landingId}": {
      "schema": "LandingPage",
      "description": "Landing pages especiais de alta conversão"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Leads recebidos de agendamento e interesse de compra/locação"
    }
  }
