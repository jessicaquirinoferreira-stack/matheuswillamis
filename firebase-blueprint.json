        "coverImage": { "type": "string" },
        "gallery": { "type": "array" },
        "unitsSummary": { "type": "string" },
        "differentialItems": { "type": "array" },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "neighborhood", "city"]
    },
    "LandingPage": {
      "title": "LandingPage",
      "description": "Landing pages premium de alta conversão para oportunidades selecionadas",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "headline": { "type": "string" },
        "subheadline": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "heroImage": { "type": "string" },
        "badgeText": { "type": "string" },
        "callToAction": { "type": "string" },
        "bullets": { "type": "array" },
        "showPrice": { "type": "boolean" },
