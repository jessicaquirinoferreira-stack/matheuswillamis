{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Configurações gerais do site institucional de Matheus Willamis Corretor",
      "type": "object",
      "properties": {
        "brokerName": { "type": "string" },
        "creci": { "type": "string" },
        "bio": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "regions": { "type": "array" },
        "heroHeadline": { "type": "string" },
        "heroSubheadline": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Property": {
      "title": "Property",
      "description": "Imóveis à venda ou locação em Olinda e região",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "code": { "type": "string" },
        "transactionType": { "type": "string" },
        "propertyType": { "type": "string" },
        "price": { "type": "number" },
        "priceFormatted": { "type": "string" },
        "locationNeighborhood": { "type": "string" },
        "locationCity": { "type": "string" },
        "bedrooms": { "type": "number" },
        "suites": { "type": "number" },
        "bathrooms": { "type": "number" },
        "parkingSpaces": { "type": "number" },
        "totalArea": { "type": "number" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "images": { "type": "array" },
        "featured": { "type": "boolean" },
        "status": { "type": "string" },
        "empreendimentoId": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "slug", "transactionType", "propertyType", "locationNeighborhood"]
    },
    "Empreendimento": {
      "title": "Empreendimento",
      "description": "Edifícios e condomínios clubes gerenciados no portal",
